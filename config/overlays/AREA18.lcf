#	===========================================================================
#	AREA18.lcf -- Metrowerks CodeWarrior overlay linker command file
#	Extermination overlay AREA18 (overlay_id=15)
#	GENERATED by tools/overlay/link_overlay.py -- do not edit by hand.
#	===========================================================================

MEMORY
{
	#	mwldmips requires a 'main' region to produce a valid ELF.
	#	We use a dummy empty region at 0x00100000 so the linker doesn't crash.
	main       (RWX) : ORIGIN = 0x00100000, LENGTH = 0
	#	Overlay arena: all overlays load at 0x00823500.
	#	mwldmips outputs an ELF with a PT_LOAD at this address; link_overlay.py
	#	extracts the text+data bytes and prepends the MWo3 header.
	overlay_AREA18 (RWX) : ORIGIN = 0x00823500, LENGTH = 0
}

SECTIONS
{
	#	$gp is the same as the boot ELF — overlays share the same address space.
	_gp = 0x0027d370;

	#	_start: the entry symbol for the main region (dummy; mwldmips needs it).
	_start = 0x00100000;

	#	Overlay entry point (the first real function in the overlay).
	__start = 0x00823540;

	#	---- Absolute symbols referenced by this overlay ----
	D_overlay_AREA18_00823D80 = 0x823D80;
	func_00000008 = 0x00000008;
	func_0000000C = 0x0000000C;

	#	Empty main section (dummy; mwldmips requires a 'main' region to be used).
	.main :
	{
	} > main

	.overlay_AREA18 :
	{
		#	2 overlay functions in vram order.
		#	No ALIGN directives — must start exactly at ORIGIN (0x00823500).
		func_overlay_AREA18_00823500.o (.text)
		overlay_AREA18_func_00823540.o (.text)

		#	---- DATA section ----
		. = ALIGN(0x10);
		ALIGNALL(4);
			data_section_0.o (.data)
		*  (.data)

		. = ALIGN(0x10);
		ALIGNALL(4);
		*  (.rodata)

		. = ALIGN(0x10);
		ALIGNALL(4);
		__static_init     = .;
		*  (.ctor)
		__static_init_end = .;

		. = ALIGN(0x10);
		ALIGNALL(4);
		*  (.sdata)

		#	---- BSS (not written to file; loader zeros it) ----
		_fbss = .;
		ALIGNALL(4);
		*  (.sbss)
		ALIGNALL(4);
		*  (.scommon)
		__bss_start = .;
		. = ALIGN(0x10);
		ALIGNALL(4);
		*  (.bss)
		ALIGNALL(4);
		*  (.common)
		ALIGNALL(4);
		*  (COMMON)
		__bss_end = .;

	} > overlay_AREA18
}


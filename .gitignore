# === Disc-derived material — NEVER commit (see CLAUDE.md hard rules) ===
# The ISO and everything produced from it stays local; users supply their own copy.
*.iso
iso/
disc/
extract/
wav/
voice/
music/
dump/
scratch/

# Boot executable (regional serials) and any ELF
SLUS_*
SLES_*
SCUS_*
SCES_*
SCPS_*
SLPS_*
SLPM_*
*.elf
# ...but the Track A build config is named after the serial and IS committed.
!SCUS_*.yaml

# Disc filesystem of Extermination (SCUS-97112)
SYSTEM.CNF
EXTER.BIN
EXTER*.DAT
DATA/
IRX/
MOVIE/
OVERLAY/
!tools/overlay/
STREAM/

# Raw binary / asset dumps pulled off the disc
*.bin
*.BIN
*.dat
*.DAT
*.irx
*.IRX
*.pss
*.PSS

# Original-binary disassembly / target objects produced locally
asm/
*.s.orig
expected/

# === Toolchain binaries — not ours to redistribute ===
*.exe
tools/mwcc*/
tools/wibo*/
tools/bin/

# === Track A (matching decomp) build artifacts ===
# build/ holds splat disassembly of the original ELF + compiled objects — all
# disc-derived; never commit. elf/ holds the locally relinked executable.
build/
elf/

# === Track B (overlay pipeline) build artifacts ===
# build/overlays/ holds per-overlay splat disassembly, filler objects, linked
# ELF, and rebuilt BIN — all derived from disc content; never commit.
# The config/overlays/ generated linker scripts (.lds) ARE committed (they are
# original code, generated from MWo3 headers that users produce themselves).
# The symbol_addrs files and YAML configs are committed; the binary outputs are not.
build/overlays/

# Overlay intermediate outputs produced by the pipeline
# (*.BIN in build/ caught by build/ ignore above; these cover edge cases)
*/_code_merged.o
*/trivial.c
*/trivial_objects.txt
.venv/
.splache/

# === Local scratch ===
.DS_Store
*.log
*.tmp
rate_test/
assets/
*.emfn
*.emui
textures/
models/
subtextures/

# Python bytecode cache
__pycache__/
*.pyc

# Root-level compile/debug scratch (objdiff probes, single-func test objects)
/*.o
/debug_*

# Personal textbook (not part of the project)
textbook/
tools/permuter/
# Third-party ee-gcc distributions stay OUT (tarballs + extracted trees), but our own
# thin wrapper scripts are original build tooling and must be tracked -- the assembler
# flags in them are load-bearing for matching (see the -G0 note in ee-compile.sh).
tools/eegcc/*
!tools/eegcc/*.sh
tools/m2c/

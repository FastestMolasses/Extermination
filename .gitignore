# === Disc-derived material — NEVER commit (see CLAUDE.md hard rules) ===
# The ISO and everything produced from it stays local; users supply their own copy.
*.iso
iso/
disc/
extract/
wav/
voice/
music/
dump/
scratch/

# Boot executable (regional serials) and any ELF
SLUS_*
SLES_*
SCUS_*
SCES_*
SCPS_*
SLPS_*
SLPM_*
*.elf
# ...but the Track A build config is named after the serial and IS committed.
!SCUS_*.yaml

# Disc filesystem of Extermination (SCUS-97112)
SYSTEM.CNF
EXTER.BIN
EXTER*.DAT
DATA/
IRX/
MOVIE/
OVERLAY/
STREAM/

# Raw binary / asset dumps pulled off the disc
*.bin
*.BIN
*.dat
*.DAT
*.irx
*.IRX
*.pss
*.PSS

# Original-binary disassembly / target objects produced locally
asm/
*.s.orig
expected/

# === Toolchain binaries — not ours to redistribute ===
*.exe
tools/mwcc*/
tools/wibo*/
tools/bin/

# === Track A (matching decomp) build artifacts ===
# build/ holds splat disassembly of the original ELF + compiled objects — all
# disc-derived; never commit. elf/ holds the locally relinked executable.
build/
elf/
.venv/
.splache/

# === Local scratch ===
.DS_Store
*.log
*.tmp
rate_test/
textures/
models/
subtextures/

# Python bytecode cache
__pycache__/
*.pyc
